# Reference only. On the server these go in Dokploy's Environment tab.

# Nunu Trading B2B login
SUPPLIER_NUNU_EMAIL=
SUPPLIER_NUNU_PASSWORD=

# Catalogue token for fragrances-wholesale.eu
SUPPLIER_FRAGRANCES_WHOLESALE_TOKEN=

# perfumes-wholesale.eu feed hash (the long code in their feed links)
SUPPLIER_PERFUMES_WHOLESALE_HASH=

# symphonya.eu API key (read-only use: stock and prices, never orders)
SUPPLIER_SYMPHONYA_KEY=

# Telegram bot from @BotFather, and your chat with it
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public address of the backoffice; enables the Telegram triage buttons (server only)
BACKOFFICE_URL=

# Backoffice login (HTTP basic auth)
BACKOFFICE_USER=
BACKOFFICE_PASSWORD=

# Cloudflare R2 bucket Litestream backs the database up to
BACKUP_R2_ACCOUNT_ID=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_R2_BUCKET=fragrance-backup

TZ=Europe/Lisbon
